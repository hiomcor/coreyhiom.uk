@page "/cv"

<SiteHeader CurrentPage="cv" />

<main id="main" class="cv-page">
    <section class="cv-intro" aria-labelledby="cv-title">
        <div><p class="eyebrow">CV / EXPERIENCE</p><p class="cv-location">Swindon, Wiltshire</p></div>
        <div><h1 id="cv-title">Full-stack<br /><em>.NET developer.</em></h1>
            <p class="cv-profile">Full-stack .NET developer with nine years of commercial experience building and maintaining web applications. My recent work includes .NET 8 and Blazor Server, SQL Server and front-end development. I also maintain older ASP.NET Web Forms and VB.NET systems, and have been rebuilding parts of a legacy CMS in Blazor. Used to tracking down bugs, working with existing code and deploying changes to live websites.</p>
            <div class="cv-actions">
                @if (SiteVisibility.ShowCvDownload)
                {
                    <a class="download-button" href="files/Corey-Hiom-CV.pdf" download="Corey-Hiom-CV.pdf">Download CV <span>PDF ↓</span></a>
                }
                <a class="text-link" href="/contact/">Get in touch</a>
            </div>
        </div>
    </section>

    <section class="cv-section" aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2><div>
            <article class="cv-entry"><p class="eyebrow">OCTOBER 2017 – PRESENT</p><h3>Developer</h3><p class="cv-subtitle">Web Development &amp; Technical Support<br />Reuben Digital Ltd · Highworth, Swindon</p>
                <p>Started as an apprentice, balancing helpdesk support and development tasks, before moving into a permanent developer role. My work covers new features, updates to existing applications and support for live client websites.</p>
                <ul>
                    <li>Develop .NET 8 / Blazor Server features using C#, dependency injection and SQL Server-backed services. Integrate external APIs and JavaScript components where needed.</li>
                    <li>Maintain and update ASP.NET Web Forms/VB.NET, .NET Framework and classic ASP applications, fixing bugs and adding features while keeping existing functionality working.</li>
                    <li>Build responsive pages and components with HTML, CSS/Sass, Bootstrap and JavaScript for client websites, CMSs and ecommerce sites.</li>
                    <li>Write and troubleshoot SQL Server queries, stored procedures and data updates. Use SSMS to investigate data errors and slow queries.</li>
                    <li>Use Git and Azure DevOps for source control, work items and build/release pipelines, with deployments through development, UAT and live IIS environments.</li>
                    <li>Integrate and maintain third-party APIs for ecommerce, order processing and authentication.</li>
                    <li>Reproduce and investigate defects using debugging tools, application logs and SQL Server data. Test fixes in development and UAT, then check they work after release.</li>
                </ul>
            </article>
            <div class="cv-earlier"><h3>Earlier experience</h3><p><strong>General Administrator</strong> · Gworks, Malmesbury<br /><span>April – October 2017</span></p></div>
        </div>
    </section>

    <section class="cv-section" aria-labelledby="skills-title"><h2 id="skills-title">Technical skills</h2><dl class="cv-skills">
        <div><dt>Microsoft web stack</dt><dd>.NET 8, C#, ASP.NET Core (Blazor Server), ASP.NET Web Forms, .NET Framework, VB.NET, classic ASP</dd></div>
        <div><dt>Front end</dt><dd>HTML5, CSS3, Sass/SCSS, Bootstrap 5, JavaScript, responsive interfaces, CMS-driven websites</dd></div>
        <div><dt>Data &amp; integration</dt><dd>SQL Server, SSMS, database design and queries, REST APIs, JSON, third-party integrations</dd></div>
        <div><dt>Development &amp; delivery</dt><dd>Git, Azure DevOps Repos/Boards/Pipelines, IIS, Windows Server, deployment and troubleshooting</dd></div>
    </dl></section>

    @if (SiteVisibility.ShowSelectedWork)
    {
    <section class="cv-section" aria-labelledby="work-title"><h2 id="work-title">Selected work</h2><div>
        <article class="cv-entry"><h3>Theatre Tokens</h3><p class="cv-stack">.NET 8 · Blazor Server · C# · SQL Server · JavaScript · Bootstrap</p><ul><li>Built theatre and store searches with town/postcode and distance filters, pagination and Leaflet maps using OpenStreetMap geocoding.</li><li>Built account and theatre-management pages for editing theatre details, uploading images and updating SQL Server records.</li><li>Connected Blazor components, injected services and JavaScript interop to handle search results, filters and interactive maps.</li></ul></article>
        <article class="cv-entry"><h3>In-house CMS v3 / visual page editor</h3><p class="cv-stack">Blazor · C# · SQL Server · JavaScript</p><ul><li>Built a visual page editor where users can drag and drop sections and content blocks, using Blazor components, JavaScript and SQL Server.</li><li>Added preview, page versioning, publishing, restore and reusable content and media controls.</li><li>Rebuilt modules from an older ASP.NET Web Forms CMS in Blazor, adapting them to work in the new CMS.</li></ul></article>
        <article class="cv-entry"><h3>National Book Tokens &amp; ecommerce sites</h3><p class="cv-stack">Blazor · SQL Server · ASP.NET · Integrations</p><ul><li>Worked on a Blazor ecommerce platform with SQL Server-backed orders, customer accounts, delivery options and reusable website components.</li><li>Maintained ecommerce and gift-card applications, investigating problems with orders, customer accounts, external integrations and live websites.</li><li>Added features to newer Blazor sites while continuing to maintain the older ASP.NET applications used alongside them.</li></ul></article>
    </div></section>

    }
    <section class="cv-section" aria-labelledby="education-title"><h2 id="education-title">Education</h2><div>
        <article class="cv-entry"><p class="eyebrow">2017 – 2018 / CIRENCESTER COLLEGE</p><h3>Advanced Level Apprenticeship in IT Application Specialist</h3><p>BTEC Level 3 Certificate in IT User Skills (ITQ)</p></article>
        <article class="cv-entry"><p class="eyebrow">2013 – 2015 / NEW COLLEGE SWINDON</p><h3>BTEC Level 3 Creative Media Production</h3><p>Games Development · Merit</p></article>
        <article class="cv-entry"><p class="eyebrow">2008 – 2013 / NOVA HREOD COLLEGE</p><h3>GCSEs</h3><p>Mathematics (A), Biology (A), Chemistry (B), Physics (B), Geography (B), English Language (B), English Literature (B), Business Communication Systems (B), German (C)</p></article>
    </div></section>
    @if (SiteVisibility.ShowCvDownload)
    {
        <div class="cv-closing"><p>Want a copy to keep?</p><a class="download-button" href="files/Corey-Hiom-CV.pdf" download="Corey-Hiom-CV.pdf">Download CV <span>PDF ↓</span></a></div>
    }
</main>
<SiteFooter />
