@page "/"
<PageTitle>Corey Hiom — Projects &amp; other things</PageTitle>
<SiteHeader HomePage="true" />
<main id="main">
    <section class="hero" aria-labelledby="intro-title">
        <div class="hero-copy"><p class="eyebrow">PROJECTS / EXPERIMENTS / OTHER THINGS</p><h2 id="intro-title">A place for the things<br />I <em>make, try &amp; explore.</em></h2><p class="intro-note">The introduction is still taking shape.<br />For now, have a look around.</p><a class="text-link" href="#projects">Explore the projects <span>↘</span></a></div>
        <div class="hero-bottom"><span>PERSONAL SITE — FIRST DRAFT</span><span>SCROLL TO EXPLORE ↓</span></div>
    </section>
    <section class="projects" id="projects" aria-labelledby="projects-title">
        <div class="section-heading"><h2 id="projects-title">Things in the making<span class="small-count">(03)</span></h2><span class="eyebrow">A FEW POSSIBLE DIRECTIONS</span></div>
        <p class="section-note">Illustrative project slots for now. The real projects will live here.</p>
        <div class="project-grid">
            <a class="project" href="#project-home">
                <div class="art art-home" aria-hidden="true"><div class="art-label">HOME / CONNECTED</div><div class="home-scene"><div class="sun"></div><div class="house-roof"></div><div class="house-body"><div class="window"></div><div class="door"></div></div><div class="signal signal-one"></div><div class="signal signal-two"></div><div class="ground"></div><div class="plant">✳</div></div><span class="art-index">01 — EVERYDAY EXPERIMENTS</span></div>
                <div class="project-caption"><h3>The connected home</h3><span>Smart home / Placeholder</span></div>
            </a>
            <a class="project" href="#project-play">
                <div class="art art-play" aria-hidden="true"><div class="art-label">IDEAS / AT PLAY</div><div class="play-scene"><div class="play-circle"></div><div class="play-square"></div><div class="play-star">✳</div><div class="play-step"></div></div><span class="art-index">02 — A LITTLE CURIOSITY</span></div>
                <div class="project-caption"><h3>Room to experiment</h3><span>Experiments / Placeholder</span></div>
            </a>
        </div>
        <a class="project-strip" href="#project-site"><span class="eyebrow">03 / YOU ARE HERE</span><h3>This little website</h3><span class="strip-detail">Personal site / In progress</span></a>
        <div class="project-details">
            <details id="project-home"><summary>The connected home <span>+</span></summary><p>A possible home for automation write-ups, useful discoveries, and small improvements to everyday life. This is a design placeholder, not a live smart home dashboard.</p></details>
            <details id="project-play"><summary>Room to experiment <span>+</span></summary><p>A space reserved for future projects and experiments. We’ll replace this example with a real project, screenshots, and its story.</p></details>
            <details id="project-site"><summary>This little website <span>+</span></summary><p>The first project: building this personal space with .NET 10 and Blazor WebAssembly. The layout, content, and colours are being explored.</p></details>
        </div>
    </section>
    <section class="about" id="about" aria-labelledby="about-title"><h2 class="eyebrow" id="about-title">A BIT ABOUT ME</h2><div><p>I’m Corey. This site brings together my projects, interests, and whatever I explore next.</p><a class="text-link" href="about">More about me</a></div></section>
    <section class="info-row">@if (SiteVisibility.ShowCv) { <div id="cv"><p class="eyebrow">THE PROFESSIONAL SIDE</p><h2>CV &amp; experience</h2><p>My experience in .NET development, technical skills, and selected work.</p><a class="text-link" href="cv">View my CV </a></div> } <div id="contact"><p class="eyebrow">KEEP IN TOUCH</p><h2>Let’s connect.</h2><p>Have something in mind? Say hello by email or connect with me on LinkedIn.</p><a class="text-link" href="contact">Get in touch </a></div></section>
</main>
<SiteFooter />
