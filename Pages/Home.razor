@page "/"
<SiteHeader HomePage="true" />

<main id="main" class="home-page">
    <section class="home-intro" aria-labelledby="intro-title">
        <p class="eyebrow home-location">SWINDON, WILTSHIRE</p>
        <div class="home-intro-copy">
            <h2 id="intro-title">Hi, I’m Corey.</h2>
            <p>I’m a developer based in Swindon with an interest in development and design.</p>
            <p>This is a place for the things I build, ideas I’m exploring, and whatever comes next.</p>
            <a class="text-link" href="/about/">More about me</a>
        </div>
    </section>

    @if (SiteVisibility.ShowProjects)
    {
        <ProjectsSection />
    }

    <section class="home-destinations" aria-label="Explore the site">
        @if (SiteVisibility.ShowCv)
        {
            <div>
                <p class="eyebrow">EXPERIENCE &amp; SKILLS</p>
                <h2>My CV</h2>
                <p>My background in .NET development, the tools I work with, and my experience.</p>
                <a class="text-link" href="/cv/">View my CV</a>
            </div>
        }
        <div>
            <p class="eyebrow">GET IN TOUCH</p>
            <h2>Say hello.</h2>
            <p>Have a question or something in mind? Send me an email or connect on LinkedIn.</p>
            <a class="text-link" href="/contact/">Contact me</a>
        </div>
    </section>
</main>

<SiteFooter />
