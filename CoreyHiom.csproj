<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="SiteVisibility.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(ShowCv)' != 'true'">
    <RazorComponent Remove="Pages/Cv.razor" />
  </ItemGroup>
  <ItemGroup Condition="'$(ShowCv)' != 'true' Or '$(ShowCvDownload)' != 'true'">
    <Content Remove="wwwroot/files/Corey-Hiom-CV.pdf" />
  </ItemGroup>

  <!-- Render the Razor pages at build time. Only this wwwroot is deployed. -->
  <Target Name="ExportStaticPages" AfterTargets="Publish">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --source &quot;$(MSBuildProjectDirectory)/wwwroot&quot; --output &quot;$(PublishDir)wwwroot&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
