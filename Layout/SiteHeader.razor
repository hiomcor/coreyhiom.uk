<header class="site-header" id="top">
    @if (HomePage)
    {
        <h1 class="wordmark">COREY HIOM</h1>
    }
    else
    {
        <a class="wordmark" href="./" aria-label="Corey Hiom — home">COREY HIOM</a>
    }
    <div class="header-line">
        <span class="tagline">Development &amp; design</span>
        <nav aria-label="Main navigation">
            <a href="./#projects">Projects</a>
            <a href="./#about">About</a>
            <a href="cv" aria-current="@(CurrentPage == "cv" ? "page" : null)">CV</a>
            <a href="contact" aria-current="@(CurrentPage == "contact" ? "page" : null)">Contact ↗</a>
        </nav>
    </div>
</header>

@code {
    [Parameter] public bool HomePage { get; set; }
    [Parameter] public string? CurrentPage { get; set; }
}
